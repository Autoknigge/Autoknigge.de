<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reifen-Ratgeber: Sicherheit, Pflege & Wechsel | Autoknigge.de</title>
    
    <!-- Google Fonts & FontAwesome für Symbole -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Cookie-Consent CSS -->
    <link rel="stylesheet" href="cookie.css">

    <style>
        :root {
            --primary-color: #1e293b;
            --accent-color: #f59e0b;
            --bg-color: #f8fafc;
            --card-radius: 12px;
            --affiliate-color: #d97706; /* Warmer Orangeton für Affiliate-Links */
        }

        body {
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
            background-color: var(--bg-color);
            color: var(--primary-color);
            line-height: 1.6;
        }

        /* Navigation / Header Bar */
        .site-nav {
            background: #0f172a;
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: white;
        }

        .site-nav a {
            color: white;
            text-decoration: none;
            margin-left: 1.5rem;
            font-size: 0.95rem;
            transition: color 0.2s;
        }

        .site-nav a:hover {
            color: var(--accent-color);
        }

        .logo {
            font-weight: 700;
            font-size: 1.25rem;
            color: var(--accent-color) !important;
        }

        header {
            background: linear-gradient(135deg, #0f172a, #1e293b);
            color: white;
            text-align: center;
            padding: 4rem 1rem;
        }

        header h1 {
            font-size: 3rem;
            margin: 0;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        header p {
            color: #94a3b8;
            font-size: 1.2rem;
            margin-top: 0.5rem;
        }

        .container {
            max-width: 1200px;
            margin: -3rem auto 4rem auto;
            padding: 0 1.5rem;
            position: relative;
        }

        /* Knigge Tipp Box Container */
        .knigge-section {
            margin-bottom: 3rem;
        }

        .knigge-box {
            background: white;
            border-radius: var(--card-radius);
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
            display: flex;
            flex-wrap: wrap;
            overflow: hidden;
            border-left: 6px solid var(--accent-color);
        }

        .knigge-img {
            flex: 1;
            min-width: 300px;
            max-height: 420px;
            overflow: hidden;
        }

        .knigge-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .knigge-content {
            flex: 1.5;
            padding: 2.5rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .knigge-content h3 {
            color: var(--accent-color);
            margin-top: 0;
            font-size: 1.5rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .knigge-quote {
            background-color: #f1f5f9;
            border-left: 4px solid var(--primary-color);
            padding: 0.8rem 1.2rem;
            margin-top: 1rem;
            border-radius: 0 8px 8px 0;
            font-style: italic;
        }

        /* Styling für den Affiliate-Link */
        a.affiliate-link {
            color: var(--affiliate-color);
            font-weight: 700;
            text-decoration: underline;
            text-decoration-style: dotted;
            transition: all 0.2s ease-in-out;
            padding: 0.1rem 0.3rem;
            background-color: #fffbe6;
            border-radius: 4px;
        }

        a.affiliate-link:hover {
            color: #b45309;
            background-color: #fef3c7;
            text-decoration: underline;
        }

        .affiliate-disclaimer {
            font-size: 0.75rem;
            color: #94a3b8;
            margin-top: 0.5rem;
            text-align: right;
        }

        /* Kacheln Grid */
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 2rem;
        }

        .card {
            background: white;
            border-radius: var(--card-radius);
            padding: 2rem;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 20px -3px rgba(0, 0, 0, 0.1);
        }

        .card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 6px;
        }

        .c-wechsel::before { background-color: #3b82f6; }
        .c-profil::before { background-color: #10b981; }
        .c-einlagerung::before { background-color: #8b5cf6; }
        .c-arten::before { background-color: #f59e0b; }
        .c-sprit::before { background-color: #ec4899; }
        .c-montage::before { background-color: #06b6d4; }
        .c-auswuchten::before { background-color: #6366f1; }
        .c-beschaedigung::before { background-color: #ef4444; }

        .card-icon {
            font-size: 2rem;
            margin-bottom: 1rem;
        }

        .c-wechsel .card-icon { color: #3b82f6; }
        .c-profil .card-icon { color: #10b981; }
        .c-einlagerung .card-icon { color: #8b5cf6; }
        .c-arten .card-icon { color: #f59e0b; }
        .c-sprit .card-icon { color: #ec4899; }
        .c-montage .card-icon { color: #06b6d4; }
        .c-auswuchten .card-icon { color: #6366f1; }
        .c-beschaedigung .card-icon { color: #ef4444; }

        .card h3 {
            margin-top: 0;
            font-size: 1.25rem;
            margin-bottom: 0.75rem;
        }

        .card p {
            color: #64748b;
            font-size: 0.95rem;
            margin: 0;
        }

        /* Footer Bereich */
        footer {
            background: #0f172a;
            color: #94a3b8;
            padding: 3rem 1.5rem;
            margin-top: 4rem;
            font-size: 0.9rem;
        }

        .footer-content {
            max-width: 1200px;
            margin: 0 auto;
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            gap: 2rem;
        }

        .footer-col h4 {
            color: white;
            margin-top: 0;
            font-size: 1.1rem;
        }

        .footer-col ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .footer-col ul li {
            margin-bottom: 0.5rem;
        }

        .footer-col ul li a {
            color: #94a3b8;
            text-decoration: none;
            transition: color 0.2s;
        }

        .footer-col ul li a:hover {
            color: var(--accent-color);
        }

        .footer-bottom {
            max-width: 1200px;
            margin: 2rem auto 0 auto;
            padding-top: 1.5rem;
            border-top: 1px solid #1e293b;
            text-align: center;
            color: #64748b;
        }

        @media (max-width: 768px) {
            header h1 { font-size: 2.2rem; }
            .container { margin-top: -1rem; }
            .site-nav { flex-direction: column; gap: 1rem; }
            .site-nav div { display: flex; flex-wrap: wrap; justify-content: center; }
            .site-nav a { margin: 0 0.5rem; }
        }
    </style>
</head>
